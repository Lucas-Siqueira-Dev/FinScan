<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinScan.App.Views.DashboardPage"
             BackgroundColor="#F4F6F8"> <ScrollView Padding="20" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="25">
            
            <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Bem-vindo de volta," FontSize="14" TextColor="#6C757D" />
                    <Label Text="{Binding SaudacaoUsuario}" FontAttributes="Bold" FontSize="22" TextColor="#212529" />
                </VerticalStackLayout>
                       
                <Button Grid.Column="1" 
                        Text="Premium" 
                        BackgroundColor="#2ECC71" 
                        CornerRadius="20" 
                        TextColor="White"
                        FontAttributes="Bold"
                        Padding="15,0"
                        HeightRequest="40"
                        MinimumWidthRequest="100"
                        Shadow="{Shadow Brush=#2ECC71, Offset='0,4', Radius=8, Opacity=0.3}"/>
            </Grid>

            <Frame BackgroundColor="#1565C0" 
                   CornerRadius="20" 
                   HasShadow="True" 
                   Padding="30"
                   BorderColor="Transparent">
                <Frame.Shadow>
                    <Shadow Brush="#1565C0" Offset="0,8" Radius="15" Opacity="0.4" />
                </Frame.Shadow>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Saldo Disponível" 
                           TextColor="#BBDEFB" 
                           FontSize="14" 
                           HorizontalOptions="Center"
                           TextTransform="Uppercase"/>
                    <Label Text="{Binding SaldoDisponivel, StringFormat='R$ {0:N2}'}" 
                           TextColor="White" 
                           FontSize="36" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Últimos Gastos" 
                   FontAttributes="Bold" 
                   FontSize="18" 
                   TextColor="#212529"
                   Margin="0,10,0,5"/>

            <CollectionView ItemsSource="{Binding UltimasLeituras}">
                
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,30,0,0">
                        <Label Text="Nenhum gasto registrado ainda." TextColor="#ADB5BD" FontSize="16" HorizontalOptions="Center"/>
                        <Label Text="Escaneie uma nota para começar." TextColor="#ADB5BD" FontSize="14" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" 
                               CornerRadius="15" 
                               Padding="15" 
                               Margin="0,0,0,12"
                               HasShadow="False"
                               BorderColor="#E9ECEF">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTransacaoTapped" CommandParameter="{Binding Valor}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                
                                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" HeightRequest="45" WidthRequest="45" Padding="10" BorderColor="Transparent" VerticalOptions="Center">
                                    <Image Source="{Binding IconeCategoria}" Aspect="AspectFit" />
                                </Frame>
                                
                                <Label Grid.Column="1" 
                                       Text="{Binding NomeServico}" 
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       TextColor="#495057"
                                       VerticalOptions="Center" 
                                       Margin="15,0,0,0"/>
                                
                                <Label Grid.Column="2" 
                                       Text="{Binding Valor, StringFormat='-R$ {0:N2}'}" 
                                       TextColor="#E74C3C" 
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>